    m_Localized: 'Today''s best: {0}'
    m_Metadata:
      m_Items: []
  - m_Id: 2509030090059779
    m_Localized: "1 / 7 \xB7 CURSED goes to VAULT. File the key."
    m_Metadata:
      m_Items: []
  - m_Id: 2509030090059780
    m_Localized: "3 / 7 \xB7 Fill the missing REPAIR stamp."
    m_Metadata:
      m_Items: []
  - m_Id: 2509030090059781
    m_Localized: "4 / 7 \xB7 STORAGE closes the first docket."
    m_Metadata:
      m_Items: []
  - m_Id: 2509030090059782
    m_Localized: "5 / 7 \xB7 Begin the next docket with STORAGE."
    m_Metadata:
      m_Items: []
  - m_Id: 2509030090059783
    m_Localized: "6 / 7 \xB7 Add REPAIR. The held shadow will return."
    m_Metadata:
      m_Items: []
  - m_Id: 2509030090059784
    m_Localized: "7 / 7 \xB7 File the returned shadow to VAULT."
    m_Metadata:
      m_Items: []
  - m_Id: 2509030090059785
    m_Localized: That desk is already stamped. Use HOLD to reach a missing desk.
    m_Metadata:
      m_Items: []
