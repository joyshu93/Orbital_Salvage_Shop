  - m_Id: 2069369009975296
    m_Localized: "REPAIR \xB7 STORAGE \xB7 VAULT\nUse HOLD when you need a second
      look."
    m_Metadata:
      m_Items: []
  - m_Id: 2069369047724032
    m_Localized: "1 / 4 \xB7 FRAGILE goes to REPAIR. File the teacup."
    m_Metadata:
      m_Items: []
  - m_Id: 2069369047724033
    m_Localized: "2 / 4 \xB7 Two rules match. The first rule wins: REPAIR."
    m_Metadata:
      m_Items: []
  - m_Id: 2069369047724034
    m_Localized: "3 / 4 \xB7 Put this item on HOLD before sorting."
    m_Metadata:
      m_Items: []
  - m_Id: 2069369047724035
    m_Localized: "3 / 4 \xB7 Now use CURSED to file the revealed key."
    m_Metadata:
      m_Items: []
  - m_Id: 2069369047724036
    m_Localized: "4 / 4 \xB7 Final check. Sort the held item without a hint."
    m_Metadata:
      m_Items: []
  - m_Id: 2069369047724037
    m_Localized: "HOLD FIRST \xB7 Use the Hold button before sorting."
    m_Metadata:
      m_Items: []
  - m_Id: 2069369047724038
    m_Localized: "FOLLOW THE NOTE \xB7 Complete the current lesson first."
    m_Metadata:
      m_Items: []
  - m_Id: 2069369047724039
    m_Localized: Training Complete
    m_Metadata:
      m_Items: []
  - m_Id: 2069369047724040
