  - m_Id: 1602203652
    m_Localized: "\uC138 \uACF3\uC758 \uBCF4\uAD00\uCC98, \uD55C \uAD8C\uC758 \uADDC\uCE59\uD45C"
    m_Metadata:
      m_Items: []
  - m_Id: 1602203653
    m_Localized: "\uADDC\uCE59\uC744 \uC704\uC5D0\uC11C \uC544\uB798\uB85C \uC77D\uC73C\uC138\uC694.
      \uBA3C\uC800 \uC77C\uCE58\uD558\uB294 \uADDC\uCE59\uC774 \uC815\uB2F5\uC785\uB2C8\uB2E4.
      \uAD50\uC721 \uC911\uC5D0\uB294 \uC2E4\uC218\uD574\uB3C4 \uD558\uD2B8\uAC00
      \uC904\uC9C0 \uC54A\uC73C\uB2C8 \uCC9C\uCC9C\uD788 \uBCF4\uB958\uB3C4 \uC0AC\uC6A9\uD574
      \uBCF4\uC138\uC694."
